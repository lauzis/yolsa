#!/usr/bin/env php
<?php
/**
 * Generates a PHP translation manifest from settings schema JSON.
 *
 * `wp i18n make-pot` scans PHP source for gettext calls, so it cannot see
 * strings that live in JSON. This writes those strings out as literal __()
 * calls in a PHP file that the scanner can read. The file is never loaded at
 * runtime and never hand-edited — regenerate it whenever a schema changes.
 *
 * Usage:
 *   bin/schema-i18n --domain=wp-plugin-packages \
 *                   --out=languages/schema-strings.php \
 *                   settings/logs.json [more.json ...]
 *
 * Exit codes: 0 written, 1 usage or read error, 2 --check found a difference.
 */

require_once __DIR__ . '/../src/Settings/Schema.php';

use Lauzis\WpPackages\Settings\Schema;

$domain = null;
$out    = null;
$check  = false;
$files  = array();

foreach ( array_slice( $argv, 1 ) as $arg ) {
	if ( 0 === strpos( $arg, '--domain=' ) ) {
		$domain = substr( $arg, 9 );
	} elseif ( 0 === strpos( $arg, '--out=' ) ) {
		$out = substr( $arg, 6 );
	} elseif ( '--check' === $arg ) {
		$check = true;
	} else {
		$files[] = $arg;
	}
}

if ( ! $domain || ! $out || ! $files ) {
	fwrite( STDERR, "usage: schema-i18n --domain=<text-domain> --out=<file.php> [--check] <schema.json> ...\n" );
	exit( 1 );
}

$strings = array();

foreach ( $files as $file ) {
	try {
		// No prefix: the manifest is about strings, not option keys.
		$sections = Schema::load( $file, array( 'domain' => $domain ) );
	} catch ( RuntimeException $e ) {
		fwrite( STDERR, $e->getMessage() . "\n" );
		exit( 1 );
	}

	Schema::walk_strings(
		$sections,
		function ( $text, $text_domain ) use ( &$strings ) {
			$strings[ $text ] = $text_domain;
		}
	);
}

ksort( $strings );

$lines = array(
	'<?php',
	'/**',
	' * Translation manifest — GENERATED, do not edit.',
	' *',
	' * Produced by bin/schema-i18n from the settings schema JSON. Exists so',
	' * `wp i18n make-pot` can see strings that live in JSON rather than in PHP.',
	' * Never loaded at runtime.',
	' *',
	' * Regenerate with:',
	' *   bin/schema-i18n --domain=' . $domain . ' --out=' . $out . ' ' . implode( ' ', $files ),
	' */',
	'',
	'return;',
	'',
);

foreach ( $strings as $text => $text_domain ) {
	$lines[] = sprintf(
		'__( %s, %s );',
		var_export( $text, true ),
		var_export( $text_domain, true )
	);
}

$contents = implode( "\n", $lines ) . "\n";

if ( $check ) {
	$current = is_readable( $out ) ? file_get_contents( $out ) : '';

	if ( $current !== $contents ) {
		fwrite( STDERR, "schema-i18n: $out is out of date; regenerate it.\n" );
		exit( 2 );
	}

	echo "schema-i18n: $out is up to date (" . count( $strings ) . " strings).\n";
	exit( 0 );
}

$dir = dirname( $out );

if ( ! is_dir( $dir ) && ! mkdir( $dir, 0755, true ) && ! is_dir( $dir ) ) {
	fwrite( STDERR, "schema-i18n: cannot create $dir\n" );
	exit( 1 );
}

file_put_contents( $out, $contents );

echo 'schema-i18n: wrote ' . count( $strings ) . " strings to $out\n";
